  object cMetge: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      'SELECT DISTINCT t.c_coordinador, m.nomsencer '
      'from CUES C'
      'join tractaments t on c.c_tractament=t.c_tractament'
      'join metges m on t.c_coordinador=m.codi'
      'WHERE t.data_ingres = "TODAY"'
      '[AND FILTRO]'
      'order by t.c_coordinador')
    Dicionario1 = wDataBasics.Metges
    Titulo = 'Triar el metge del que es vol gestionar la cua de visites'
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    VerSimple = True
    AlSeleccionar = cMetgeAlSeleccionar
    AlDespuesOpen = cMetgeAlDespuesOpen
    Left = 288
    Top = 128
  end
