  object PanelLista: HYPanelConsulta
    Left = 0
    Top = 133
    Width = 1097
    Height = 318
    Align = alClient
    BevelOuter = bvNone
    Caption = 'PanelLista'
    Color = clSilver
    TabOrder = 2
    Abierta = False
    SqlDic.Strings = (
      
        'SELECT C_Espera, Visitat, Data_PreIngres, Hora_PreIngres, C_Hist' +
        'oria, NomComplet, EDAT, Sexe, C_Unitat, TELEFON, C_Coordinador, ' +
        'C_Especial, N_Especial, C_Prestacio, N_Prestacio, Motiu, C_MOTIU' +
        ', Modalitat, C_Modalitat, Unitat_Medica, Consulta, Facturar, Tip' +
        'us, Nom, Cognom1, Cognom2, C_Estat, centrefac, client, c_om, Met' +
        'ge_Programa, Comentari, Data_Naix, CIP, c_client, idregistre, c_' +
        'transport_sanitari, C_Procedencia, C_TractamentOrigen, Centre'
      'FROM P_ESPERA_AGENDA(  '
      '/*COORDINADOR*/ ,                   /* l'#237'nia 2 */'
      '/*PRESTACIO*/       ,                    /* l'#237'nia 3 */'
      '/*DATA_DESDE*/   ,                    /* l'#237'nia 4 */'
      '/*DATA_HASTA*/                        /* l'#237'nia 5 */'
      ')'
      '[FILTRO]                '
      '[ORDEN]')
    Dicionario1 = wDataAdmisio.Espera
    Titulo = 'Programaci'#243' agenda (%s)'
    Filtros = <
      item
        Nombre = 'Centre'
        NombreDB = 'CENTRE'
        Tipo = tiCaracter
        Condicion = tiIgual
      end>
    OrdenAuto = True
