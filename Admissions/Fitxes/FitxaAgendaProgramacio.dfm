  end
  object Q: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      'select P.N_PRESTACIO, '
      '          T.C_COORDINADOR, '
      '          T.DATA_INGRES, '
      '          T.C_COORDINADOR||" - "||E.N_ESPECIAL  AS N_ESPECIAL'
      'from   TRACTAMENTS T '
      
        'join CODICAMPS X on T.C_ESTATFAC = X.C_CODI and X.TIPUSCODI = "E' +
        'STATFACTU" and X.R_CODI <> 9'
      'left outer join METGES M on M.CODI = T.C_COORDINADOR'
      'left outer join ESPECIAL E on E.C_ESPECIAL = M.C_ESPECIAL'
      'left outer join PRESTACION P on P.C_PRESTACIO = T.C_PRESTACIO'
      'where T.C_HISTORIA = :c_historia  '
      '/* m'#233's filtres            l'#237'nia 10 */')
    Left = 248
    Top = 264
    ParamData = <
      item
        DataType = ftInteger
        Name = 'c_historia'
        ParamType = ptInput
      end>
  end
  object cCoordinador: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      'select distinct M.CODI, M.NOMSENCER, M.C_GRUP'
      'from METGES M'
      'join HORARIO H on M.CODI = H.C_METGE'
      'where M.BAIXA = '#39'N'#39
      '[AND FILTRO]'
      'order by M.C_GRUP, M.CODI')
    Dicionario1 = wDataBasics.Metges
    Titulo = 'Seleccioneu el coordinador original'
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    VerExcel = False
    VerPrint = False
    VerSimple = True
    AlSeleccionar = cCoordinadorAlSeleccionar
    Left = 897
    Top = 248
  end
  object cSubstitut: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      'select distinct M.CODI, M.NOMSENCER, M.C_GRUP'
      'from METGES M'
      'join HORARIO H on M.CODI = H.C_METGE'
      'where M.BAIXA = '#39'N'#39
      'and M.C_GRUP = '#39'ME'#39'    /* l'#237'nia 4 */'
      'and M.CODI <> '#39'P04'#39'       /* l'#237'nia 5 */'
      '[AND FILTRO]'
      'order by M.CODI')
    Dicionario1 = wDataBasics.Metges
    Titulo = 'Seleccioneu el coordinador substitut'
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    VerExcel = False
    VerPrint = False
    VerSimple = True
    AlSeleccionar = cSubstitutAlSeleccionar
    Left = 961
    Top = 248
  end
