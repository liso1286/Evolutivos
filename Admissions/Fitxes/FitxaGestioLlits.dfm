  object qDieta: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'select f.nomcomplet as pacient, f.c_dieta, c.n_codi, f.obs_dieta' +
        ', f.hora_dinar, f.c_ubicacio_dinar, c2.n_codi as ubicacio'
      
        'from filiacio f left join codicamps c on f.c_dieta = c.c_codi an' +
        'd c.tipuscodi ="DIETES"'
      
        'left join codicamps c2 on c2.tipuscodi="UBICACIO_DINAR" and c2.c' +
        '_codi=f.c_ubicacio_dinar'
      'WHERE F.NUM_HIST = 10005  /* LINIA 3 */')
    Left = 832
    Top = 304
  end
