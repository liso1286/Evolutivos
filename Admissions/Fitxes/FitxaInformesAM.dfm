  object qDadesReg: TQuery
    DatabaseName = 'Interna'
    DataSource = dsDades
    SQL.Strings = (
      
        'SELECT ir.accio, c.n_codi, ir.c_usuari, m.metge, ir.data, ir.com' +
        'entari'
      'FROM informes_reg ir'
      
        'join codicamps c on c.tipuscodi='#39'INFORMES.ACCIO'#39' and c.c_codi=ir' +
        '.accio'
      'left join metges m on ir.c_usuari=m.codi'
      'where ir.id_informe = :id_informe'
      'order by ir.linia')
    Left = 992
    Top = 136
    ParamData = <
      item
        DataType = ftInteger
        Name = 'ID_INFORME'
        ParamType = ptInput
        Size = 4
      end>
    object qDadesRegACCIO: TSmallintField
      FieldName = 'ACCIO'
    end
    object qDadesRegN_CODI: TStringField
      FieldName = 'N_CODI'
      Size = 40
    end
    object qDadesRegC_USUARI: TStringField
      FieldName = 'C_USUARI'
      Size = 5
    end
    object qDadesRegMETGE: TStringField
      FieldName = 'METGE'
    end
    object qDadesRegDATA: TDateTimeField
      FieldName = 'DATA'
    end
    object qDadesRegCOMENTARI: TStringField
      FieldName = 'COMENTARI'
      Size = 250
    end
  end
  object dsDadesReg: TDataSource
    DataSet = qDadesReg
    Left = 1056
    Top = 136
  end
