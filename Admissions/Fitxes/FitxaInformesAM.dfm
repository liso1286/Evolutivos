  object cMetges: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      'select M.CODI, M.METGE, M.NOMSENCER, M.C_GRUP, M.C_ESPECIAL'
      'from METGES M '
      'where M.BAIXA = '#39'N'#39
      
        'and (CODI in (select C_USUARI from DRETSMETGES where C_DRET = '#39'M' +
        '229'#39')'
      
        ' or C_GRUP in (select C_GRUP from DRETSGRUPS where C_DRET = '#39'G17' +
        '3'#39')'
      
        ' or C_ESPECIAL in (select C_ESPECIAL from DRETSESPECIAL where C_' +
        'DRET = '#39'E43'#39'))'
      
        'and M.C_GRUP not in (select C_GRUP from DRETSGRUPS where C_DRET ' +
        '= '#39'G180'#39')'
      
        'and M.CODI not in (select C_USUARI from DRETSMETGES where C_DRET' +
        ' = '#39'M999'#39')'
      '[AND FILTRO]'
      '[ORDEN]')
    SqlDicTotal.Strings = (
      'select COUNT(*)'
      'from METGES M '
      'where M.BAIXA = '#39'N'#39
      
        'and (CODI in (select C_USUARI from DRETSMETGES where C_DRET = '#39'M' +
        '229'#39')'
      
        ' or C_GRUP in (select C_GRUP from DRETSGRUPS where C_DRET = '#39'G17' +
        '3'#39')'
      
        ' or C_ESPECIAL in (select C_ESPECIAL from DRETSESPECIAL where C_' +
        'DRET = '#39'E43'#39'))'
      
        'and M.C_GRUP not in (select C_GRUP from DRETSGRUPS where C_DRET ' +
        '= '#39'G180'#39')'
      
        'and M.CODI not in (select C_USUARI from DRETSMETGES where C_DRET' +
        ' = '#39'M999'#39')'
      '[AND FILTRO]'
      '[ORDEN]')
    Dicionario1 = wDataBasics.Metges
    Titulo = 
      'Tria el professional a qui se il demana l'#39'informe. ESC per sorti' +
      'r'
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    VerExcel = False
    VerPrint = False
    VerSimple = True
    VerSalir = False
    AlSeleccionar = cMetgesAlSeleccionar
    AlDespuesOpen = AlDespuesOpen
    Left = 200
    Top = 56
  end
