  object cAccions: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      'select c.n_codi, i.linia, i.data, i.c_usuari, m.metge'
      'from informes_reg i'
      
        'join codicamps c on c.tipuscodi='#39'INFORMES.ACCIO'#39' and c.c_codi=i.' +
        'accio'
      'left join metges m on i.c_usuari=m.codi'
      'where i.id_informe=49812 /* l'#237'nia 4 */'
      '[AND FILTRO]'
      'order by i.linia')
    Dicionario1 = wDataInformes.Informes_Reg
    Titulo = 'Llistat d'#39'accions realitzades amb l'#39'informe'
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    VerPrint = False
    VerSimple = True
    Left = 144
    Top = 176
  end
  object qAccions: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'select cast(c.n_codi as VARCHAR(40)) as N_CODI, i.linia, i.data,' +
        ' i.c_usuari, m.metge, COALESCE(H.ANOTACIO, i.comentari) AS ANOTA' +
        'CIO'
      'from informes_reg i'
      
        'join codicamps c on c.tipuscodi='#39'INFORMES.ACCIO'#39' and c.c_codi=i.' +
        'accio'
      'LEFT JOIN INFORMES INF ON I.ID_INFORME=INF.ID_INFORME'
      'left join metges m on i.c_usuari=m.codi'
      'LEFT JOIN HISTORIA H ON INF.C_ANOTACIO=H.C_ANOTACIO '
      'where i.id_informe=:id_informe'
      'order by 2')
    Left = 96
    Top = 88
    ParamData = <
      item
        DataType = ftInteger
        Name = 'id_informe'
        ParamType = ptInput
      end>
    object qAccionsN_CODI: TStringField
      FieldName = 'N_CODI'
      Size = 40
    end
    object qAccionsLINIA: TIntegerField
      FieldName = 'LINIA'
    end
    object qAccionsDATA: TDateTimeField
      FieldName = 'DATA'
    end
    object qAccionsC_USUARI: TStringField
      FieldName = 'C_USUARI'
      Size = 5
    end
    object qAccionsMETGE: TStringField
      FieldName = 'METGE'
    end
    object qAccionsANOTACIO: TMemoField
      FieldName = 'ANOTACIO'
      BlobType = ftMemo
      Size = 30000
    end
  end
