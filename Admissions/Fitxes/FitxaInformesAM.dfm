  object qDades: TQuery
    AfterScroll = qDadesAfterScroll
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'select i.*, ir.data, f.nomcomplet, f.c_unitatmedica, u.n_unitatm' +
        ', c1.n_codi, c2.n_codi, f.idioma, m.nomsencer,'
      
        '       ir.c_usuari, cc.n_codi , t.publicar_hc3 as PUBLICAR_HC3_T' +
        'IPUS, t.publicar_app, TR.C_CENTREFAC, TR.C_CLIENT'
      'from informes i '
      
        'join informes_tipus t on i.c_tipus = t.c_tipus and t.solicitable' +
        ' <> '#39'N'#39
      
        'join informes_reg ir on i.id_informe = ir.id_informe and ir.lini' +
        'a=1 '
      'join filiacio f on i.c_historia = f.num_hist '
      'join unitatm u on f.c_unitatmedica=u.c_unitatm'
      
        'join codicamps c1 on i.c_estat = c1.c_codi and c1.tipuscodi = '#39'I' +
        'NFORMES.ESTAT'#39
      'left join metges m on i.c_USUARI = m.codi'
      
        'left join codicamps c2 on i.c_entrega = c2.c_codi and c2.tipusco' +
        'di = '#39'INFORMES.ENTREGA'#39
      
        'left join codicamps cc on cc.tipuscodi='#39'INFORMES.GESTIONA'#39' and i' +
        '.gestionat = cc.c_codi '
      'LEFT JOIN TRACTAMENTS TR ON I.C_TRACTAMENT=TR.C_TRACTAMENT'
      'where C1.R_CODI = '#39'EN_CURS'#39' /* linia 12 - filtre estat */'
      '/* linia 13 per altres filtres */'
      'and i.gestionat is null /* linia 14 per filtre de area */ '
      'ORDER BY IR.DATA DESC, I.C_HISTORIA  /* linia 15 per ordenar */')
    Left = 8
    Top = 120
