  object pIngressats: HYPanelConsulta
    Left = 0
    Top = 0
    Width = 1373
    Height = 380
    Align = alClient
    BevelOuter = bvNone
    Caption = 'Pacients Ingressats'
    Color = clSilver
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -11
    Font.Name = 'MS Sans Serif'
    Font.Style = []
    ParentFont = False
    TabOrder = 0
    Abierta = False
    SqlDic.Strings = (
      
        'select T.C_PRESTACIO,  P.N_PRESTACIO,F.ESVIU, T.C_TRACTAMENT, T.' +
        'C_HISTORIA, F.NOMCOMPLET, F.SEXO, F.EDAT, T.C_LLIT, T.C_PLANTA, ' +
        'PL.N_PLANTA, F.UNITAT AS C_UNITAT, F.UNITAT, T.C_COORDINADOR, T.' +
        'DATA_INGRES, T.DATA_PREALTA, T.DATA_ALTA,/* T.PAPERS,*/ T.PASSI,' +
        ' T.C_CENTREFAC, T.C_ESTATFAC, C.N_CODI, /* A.ESTAT,*/  f.c_dieta' +
        ', f.obs_dieta, F.Incapacitat, F.CONSENTIMENT, f.hora_dinar, f.c_' +
        'ubicacio_dinar, c2.n_codi as ubicacio, T.CADUCAPERMIS, PL.TIPUS'
      'from TRACTAMENTS T '
      'join FILIACIO F on T.C_HISTORIA = F.NUM_HIST '
      'join PRESTACION P on P.C_PRESTACIO = T.C_PRESTACIO'
      'join PLANTES PL on T.C_PLANTA = PL.C_PLANTA'
      
        'join CODICAMPS C on C.C_CODI  = T.C_ESTATFAC and C.TIPUSCODI ="E' +
        'STATFACTU"'
      
        'join DRETSPRESTA DP on P.C_PRESTACIO = DP.C_PRESTACIO and DP.C_D' +
        'RET = '#39'P54'#39
      
        'left join CODICAMPS C2 on C2.TIPUSCODI="UBICACIO_DINAR" and C2.C' +
        '_CODI=F.C_UBICACIO_DINAR'
      ''
      'where (DATA_ALTA is NULL'
      '        or DATA_ALTA >= "TODAY")'
      ''
      '[AND FILTRO]'
      '[ORDEN]')
    SqlDicTotal.Strings = (
      'SELECT count(*)'
      
        'FROM (((TRACTAMENTS T JOIN FILIACIO F ON T.C_HISTORIA = F.NUM_HI' +
        'ST) JOIN PRESTACION P ON P.C_PRESTACIO = T.C_PRESTACIO) JOIN PLA' +
        'NTES PL ON T.C_PLANTA = PL.C_PLANTA)  JOIN CODICAMPS C ON C.C_CO' +
        'DI  = T.C_ESTATFAC AND C.TIPUSCODI ="ESTATFACTU"'
      'WHERE (DATA_ALTA IS NULL'
      '        OR DATA_ALTA >= "TODAY")'
      
        ' AND ((T.C_PRESTACIO   = "1004") or ((t.c_prestacio='#39'9999'#39') and ' +
        '(t.c_prestacioorigen='#39'1004'#39')))'
      '[AND FILTRO]'
      '[ORDEN]'
      '')
    Dicionario1 = wDataBasics.Tractaments
    Dicionario2 = wDataBasics.Filiacio
    Titulo = 'Pacients Ingressats'
    Orden.Strings = (
      'DATA_INGRES DESC')
    OrdenDB.Strings = (
      'DATA_INGRES DESC')
    Filtros = <
      item
        Nombre = 'Coordinador'
        NombreDB = 't.C_Coordinador'
        Diccionario = wDataBasics.Tractaments
        Tipo = tiCaracter
        Condicion = tiContiene
        Campo = 'C_Coordinador'
      end
      item
        Nombre = 'Nom Complet'
        NombreDB = 'f.NomComplet'
        Diccionario = wDataBasics.Tractaments
        Tipo = tiCaracter
        Condicion = tiContiene
        Campo = 'Nom Complet'
      end
      item
        Nombre = 'Historia'
        NombreDB = 't.C_Historia'
        Diccionario = wDataBasics.Tractaments
        Tipo = tiNumero
        Condicion = tiRango
        Campo = 'N'#186' Historia'
      end
      item
        Nombre = 'Prestacio'
        NombreDB = 't.C_Prestacio'
        Diccionario = wDataBasics.Tractaments
        Tipo = tiCaracter
        Condicion = tiContiene
        Campo = 'Prestaci'#243
      end
      item
        Nombre = 'Unitat'
        NombreDB = 'f.Unitat'
        Diccionario = wDataBasics.Tractaments
        Tipo = tiCaracter
        Condicion = tiRango
        Campo = 'Unitat'
      end
      item
        Nombre = 'Data_PreAlta'
        NombreDB = 't.Data_PreAlta'
        Diccionario = wDataBasics.Tractaments
        Tipo = tiFecha
        Condicion = tiRango
        Campo = 'Data_PreAlta'
      end
      item
        Nombre = 'centre facturacio'
        NombreDB = 't.c_centrefac'
        Diccionario = wDataBasics.Tractaments
        Tipo = tiCaracter
        Condicion = tiIgual
        Campo = 't.c_centrefac'
      end>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
