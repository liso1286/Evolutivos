  object qDieta: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'select f.nomcomplet as pacient, f.c_dieta, c.n_codi, f.obs_dieta' +
        ', f.hora_dinar, f.c_ubicacio_dinar, c2.n_codi as ubicacio'
      
        'from filiacio f left join codicamps c on f.c_dieta = c.c_codi an' +
        'd c.tipuscodi ="DIETES"'
      
        'left join codicamps c2 on c2.tipuscodi='#39'UBICACIO_DINAR'#39' and c2.c' +
        '_codi=f.c_ubicacio_dinar'
      'WHERE F.NUM_HIST = 10005  /* LINIA 3 */')
    Left = 816
    Top = 496
  end
  object cIngressats: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      
        'select T.C_PRESTACIO,  P.N_PRESTACIO,F.ESVIU, T.C_TRACTAMENT, T.' +
        'C_HISTORIA, F.NOMCOMPLET, F.SEXO, F.EDAT, T.C_LLIT, T.C_PLANTA, ' +
        'PL.N_PLANTA, F.UNITAT AS C_UNITAT, F.UNITAT, T.C_COORDINADOR, T.' +
        'DATA_INGRES, T.DATA_PREALTA, T.DATA_ALTA,/* T.PAPERS,*/ T.PASSI,' +
        ' T.C_CENTREFAC, T.C_ESTATFAC, C.N_CODI, /* A.ESTAT,*/  f.c_dieta' +
        ', f.obs_dieta'
      'from TRACTAMENTS T '
      'join FILIACIO F on T.C_HISTORIA = F.NUM_HIST '
      'join PRESTACION P on P.C_PRESTACIO = T.C_PRESTACIO'
      'join PLANTES PL on T.C_PLANTA = PL.C_PLANTA'
      
        'join CODICAMPS C on C.C_CODI  = T.C_ESTATFAC and C.TIPUSCODI ="E' +
        'STATFACTU"'
      
        'join DRETSPRESTA DP on P.C_PRESTACIO = DP.C_PRESTACIO and DP.C_D' +
        'RET='#39'P54'#39
      'where (DATA_ALTA is NULL'
      '        or DATA_ALTA >= "TODAY")'
      '      '
      '[AND FILTRO]'
      '[ORDEN]')
    Dicionario1 = wDataBasics.Tractaments
    Dicionario2 = wDataBasics.Filiacio
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    AlSeleccionar = cIngressatsAlSeleccionar
    Left = 832
    Top = 144
  end
