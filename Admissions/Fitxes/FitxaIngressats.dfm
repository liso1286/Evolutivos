  object cLlitsBuits: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      
        'SELECT S.C_LLIT, S.PLANTA, S.N_Planta, S.PLANTA_TIPUS, S.HISTORI' +
        'A'
      'FROM P_ESPERA_LLITS(NULL, "S") S'
      'WHERE S.TIPUS = "L"'
      '[AND FILTRO]'
      ''
      'UNION'
      ''
      
        'SELECT CAST (NULL AS VARCHAR(3)) AS C_LLIT, CAST (P.C_PLANTA AS ' +
        'VARCHAR(15)) AS PLANTA, CAST (NULL AS VARCHAR(20)), CAST(P.TIPUS' +
        ' AS VARCHAR(1)) AS PLANTA_TIPUS, CAST(NULL AS INTEGER) AS HISTOR' +
        'IA'
      'FROM PLANTES P WHERE 1=1'
      '[AND FILTRO]'
      '[ORDEN]')
    SqlDicTotal.Strings = (
      'SELECT COUNT(*) AS LLITS_BUITS'
      'FROM P_ESPERA_LLITS(NULL, "S")'
      'WHERE TIPUS = "L"'
      '[AND FILTRO]'
      '[ORDEN]'
      ''
      '')
    Dicionario1 = wDataAdmisio.Llits
    Titulo = 'Llistat de Llits Buits'
    Orden.Strings = (
      'LLIT')
    OrdenDB.Strings = (
      '1')
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    VerExcel = False
    CamposOculta.Strings = (
      'N_PLANTA'
      'PLANTA_TIPUS'
      'HISTORIA')
    AlSeleccionar = cLlitsBuitsAlSeleccionar
    Left = 115
    Top = 9
  end
