      ImageIndex = 38
      ShortCut = 120
      OnExecute = TancarPreopExecute
    end
  end
  object cPrestacio: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      'select DISTINCT P.*'
      'from DRETSPRESTA D '
      'join PRESTACION P on D.C_PRESTACIO = P.C_PRESTACIO'
      'left join DRETSPRESTA DP on P.C_PRESTACIO = DP.C_PRESTACIO'
      'where P.TIPUS > -1 '
      'and D.C_DRET = "P1" and DP.C_DRET<>"P256"'
      '[AND FILTRO]'
      'order by P.C_PRESTACIO'
      '')
    Dicionario1 = wDataBasics.Prestacion
    Dicionario2 = wDataAdmisio.PrestaCodiCamps
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    AutoRefreshOnActivate = True
    AlSeleccionar = cPrestacioAlSeleccionar
    Left = 256
    Top = 8
  end
  object Presta: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'select P.C_PRESTACIO || ". " || P.N_PRESTACIO, P.C_PRESTACIO, P.' +
        'N_PRESTACIO'
      'from DRETSPRESTA D '
      'join PRESTACION P on D.C_PRESTACIO = P.C_PRESTACIO'
      'where P.TIPUS > -1'
      'and D.C_DRET = "P1"'
      'order by P.C_PRESTACIO')
    Left = 311
    Top = 9
  end
end
