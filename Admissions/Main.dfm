  object cTimeOutCE: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      
        'select t.c_historia, f.nomcomplet, t.data_ingres, t.data_alta, t' +
        '.c_prestacio, c.data_timeout, c.C_USER_TIMEOUT, c.c_procediment,' +
        ' i.n_icd'
      'from TIMEOUTCMA C                                 '
      
        'join TRACTAMENTS T on C.C_TRACTAMENT = T.C_TRACTAMENT           ' +
        '  '
      
        'join PRESTACION  P on T.C_PRESTACIO = P.C_PRESTACIO AND P.TIPUS=' +
        '2 '
      'join FILIACIO F on T.C_HISTORIA=F.NUM_HIST'
      
        'LEFT join CODIICD I on C.C_PROCEDIMENT=I.C_ICD AND C.VERSIOCIM=I' +
        '.VERSIOCIM'
      
        'where T.C_PRESTACIO <> "2006" and "TODAY" - C.DATA_TIMEOUT < 20 ' +
        '  '
      '[AND FILTRO]'
      '[ORDEN]'
      ''
      '')
    SqlDicTotal.Strings = (
      'select COUNT(*)'
      'from TIMEOUTCMA C                                 '
      
        'join TRACTAMENTS T on C.C_TRACTAMENT = T.C_TRACTAMENT           ' +
        '  '
      
        'join PRESTACION  P on T.C_PRESTACIO = P.C_PRESTACIO AND P.TIPUS=' +
        '2 '
      
        'where T.C_PRESTACIO <> "2006" and "TODAY" - C.DATA_TIMEOUT < 20 ' +
        '  ')
    Dicionario1 = wDataBasics.Tract_Resum
    Titulo = 'Interconsultes Urologia d'#39'ingressats pendents de programar'
