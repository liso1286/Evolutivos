  object cMedicacioNPC: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      
        '  SELECT O.C_HISTORIA, F.NOMCOMPLET, P.N_REG, O.DATA_PAUTAT, O.D' +
        'URADA, O.DIES,'
      
        '         O.DATA_INICI, O.HORA_INICI, O.DATA_SUSPENSIO FROM ORDRE' +
        'SMEDIQUES O'
      '  JOIN FILIACIO F ON O.C_HISTORIA=F.NUM_HIST'
      
        '  JOIN TRACTAMENTS T ON O.C_TRACTAMENT=T.C_TRACTAMENT AND T.C_CE' +
        'NTREFAC IN('#39'00'#39','#39'50'#39')'
      '  JOIN PRODUCTES P ON O.C_PRODUCTE=P.C_PROD'
      
        '  WHERE O.DATA_ASSIGNACIO is not null /* BETWEEN '#39'1.9.2016'#39' AND ' +
        #39'30.9.2016 23:59:59'#39'  - linia 5*/'
      '  AND P.FACTURABLEPRIVATS = '#39'S'#39
      
        '  AND ((O.DATA_INICI+(O.HORA_INICI/24) < O.DATA_SUSPENSIO) OR O.' +
        'DATA_SUSPENSIO IS NULL)'
      '[AND FILTRO]'
      '[ORDEN]')
    Dicionario1 = wDataOMdics.OrdresMediques
    Titulo = 'Medicacions privades pacients NPC'
    Orden.Strings = (
      'data pauta desc')
    OrdenDB.Strings = (
      'data_pautat desc')
    Filtros = <>
    OrdenAuto = False
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    VerExcel = False
    VerPrint = False
    VerSimple = True
    AutoRefreshOnActivate = True
    CamposOculta.Strings = (
      'data_suspensio')
    Left = 294
    Top = 432
  end
  object cInterconPrivats: THYConsulta
