  object cAnulaAlta: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      'select T.C_HISTORIA, F.NOMCOMPLET,  T.C_PRESTACIO, P.RESUM, '
      'T.DATA_INGRES, A.C_TRACTAMENT, A.C_USUARI, A.DATA'
      'from ANULAALTA A '
      'join TRACTAMENTS T on A.C_TRACTAMENT = T.C_TRACTAMENT'
      'join PRESTACION P on T.C_PRESTACIO = P.C_PRESTACIO'
      'join FILIACIO F on T.C_HISTORIA = F.NUM_HIST'
      'where A.ESTAT = 0')
    Dicionario1 = wDataCurs.AnulaAlta
    Titulo = 'ANUL'#183'LACIONS D'#39'ALTES ADMINISTRATIVES'
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    AutoRefreshOnActivate = True
    CamposOculta.Strings = (
      'C_TRACTAMENT')
    AlSeleccionar = cAnulaAltaAlSeleccionar
    Left = 41
    Top = 295
  end
