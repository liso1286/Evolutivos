    SqlDic.Strings = (
      'select i.c_historia, f.nomcomplet, i.data1, i.c_metge1, m.metge'
      'FROM INTERCON I                                             '
      
        'join TRACTAMENTS T on i.c_tractament= t.c_tractament and t.c_cen' +
        'trefac in("00","50") '
      'join filiacio f on i.c_historia=f.num_hist'
      'join metges m on i.c_metge1 = m.codi'
      'where i.c_tipus="PROVESP"  /* linia 5 */'
      'and i.data1 between "NOW"-5 and "NOW"             '
      'and not (i.estat between 80 and 89)  and (i.estat<>97)')
