  object cInferInformes: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      
        'select I.ESTAT, C1.N_CODI2 as N_ESTAT, I.C_HISTORIA, F.NOMCOMPLE' +
        'T, '
      
        '          T.C_PRESTACIO, T.DATA_INGRES, T.DATA_PREALTA, T.DATA_A' +
        'LTA,  '
      '          I.DATA_INFORME, I.C_USUARI, M.METGE, T.C_TRACTAMENT,'
      
        '          I.DATA_VALIDACIO, I.C_VALIDADOR,  V.METGE, I.CORRECCIO' +
        'NS, '
      
        '          I.TIPUS, C2.N_TIPUS as TIPUS_INFORME, C2.PUBLICAR_HC3,' +
        ' C2.DATA_ARXIU,'
      
        '          I.ARXIU, I.ID, I.ID_INFORME, C2.PUBLICAR_APP, T.C_CENT' +
        'REFAC, T.C_CLIENT'
      'from INFERINFORMES I'
      
        'join CODICAMPS C1 on I.ESTAT = C1.C_CODI and C1.TIPUSCODI = "INF' +
        'INFERMERIA.ESTAT"'
      'join INFORMES_TIPUS C2 on I.TIPUS = C2.C_TIPUS'
      'join TRACTAMENTS T on I.C_TRACTAMENT = T.C_TRACTAMENT'
      'join FILIACIO F on  I.C_HISTORIA = F.NUM_HIST'
      'join METGES M on I.C_USUARI = M.CODI'
      'left outer join METGES V on I.C_VALIDADOR = V.CODI'
      '[FILTRO]'
      '[ORDEN]')
    Dicionario1 = wDataInfermeria.InferInformes
    Dicionario2 = wDataBasics.Filiacio
    Dicionario3 = wDataBasics.Tract_Resum
    Titulo = 'Informes d'#39'infermeria pendents'
    Orden.Strings = (
      'Data validaci'#243', data informe')
    OrdenDB.Strings = (
      'DATA_VALIDACIO, DATA_INFORME')
    Filtros = <
      item
        Nombre = 'fEstat'
        NombreDB = 'I.ESTAT'
        Valor1 = '5'
        Tipo = tiNumero
        Condicion = tiMenor
      end>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    VerExcel = False
    VerPrint = False
    VeureAltraCosa = True
    VeureAltreBoto = True
    NomAltraCosa = 'Deixar pendent de validar o pendent d'#39'alta'
    NomAltreBoto = 'Anul'#183'la'
    VerSimple = True
    VerSeleccionar = True
    CamposOculta.Strings = (
      'ESTAT'
      'C_USUARI'
      'C_VALIDADOR'
      'TIPUS'
      'ARXIU'
      'ID'
      'ID_INFORME'
      'C_TRACTAMENT'
      'PUBLICAR_HC3'
      'DATA_ARXIU'
      'PUBLICAR_APP'
      'C_CENTREFAC'
      'C_CLIENT')
    AlSeleccionar = cInferInformesProcessa
    AlPintarGridFont = cInferInformesAlPintarGridFont
