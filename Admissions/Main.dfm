  object cCanvisUM: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      
        'select L.QUI, L.C_HISTORIA, F.NOMCOMPLET, L.UM_ANTIGA, L.UM_NOVA' +
        ', '
      
        'U1.N_UNITATM as desc_Antiga, U2.N_UNITATM as desc_Nova, L.DATA, ' +
        'L.METGE'
      'from LOGUM L'
      'join  FILIACIO F on L.C_HISTORIA = F.NUM_HIST'
      'join  UNITATM U1 on L.UM_ANTIGA = U1.C_UNITATM'
      'join  UNITATM U2 on L.UM_NOVA     = U2.C_UNITATM'
      'where F_Modulo(QUI, 2) = 1'
      ''
      '')
    Dicionario1 = wDataBasics.LogUM
    Titulo = 'Pacients antics amb canvi d'#39'unitat m'#232'dica'
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    VerPrint = False
    VerSeleccionar = True
    CamposOculta.Strings = (
      'QUI')
    AlSeleccionar = cCanvisUMAlSeleccionar
    AlTancar = cCanvisUMAlTancar
    Left = 553
    Top = 100
  end
  object cECOSprog: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      
        'select I.C_INTERCON, T.C_HISTORIA, F.NOMCOMPLET, T.C_PRESTACIO, ' +
        'T.DATA_INGRES, T.C_MOTIU, M.N_CODI as N_MOTIU, I.DATA1'
      'from INTERCON I'
      'join TRACTAMENTS T on I.C_TRACTAMENT = T.C_TRACTAMENT'
      'join FILIACIO F on T.C_HISTORIA = F.NUM_HIST'
      
        'join CODICAMPS M on T.C_MOTIU = M.C_CODI and M.TIPUSCODI = "MOTI' +
        'U"'
      'join DRETSMOTIU D on T.C_MOTIU = D.C_MOTIU and D.C_DRET = "X6"'
      'where I.C_TIPUS = "ECOS"'
      'and I.ESTAT = 12 '
      'and T.C_PRESTACIO = "1004" '
      'and I.DATA_PREVISTA is NULL '
      'and I.DATA_PROVA is NULL'
      '[AND FILTRO]'
      '[ORDEN]'
      ''
      '')
    Dicionario1 = wDataIntercon.vInterconbis
    Dicionario2 = wDataBasics.Tract_Resum
