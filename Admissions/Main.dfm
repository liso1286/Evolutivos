  object cRenovacioMutues: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      'SELECT'
      ''
      
        'T.C_Historia, F.NOMCOMPLET, T.C_Prestacio, P.N_Prestacio, T.Data' +
        '_Ingres, T.C_Coordinador, M.METGE AS N_Coordinador, /*Papers,*/ ' +
        'C_CentreFac, C_Client, C_Delegacio, CaducaPermis, PercentatgePac' +
        'ient, T.Data_PreAlta, T.C_MetgePreAlta, M2.METGE AS N_Metge_PreA' +
        'lta, T.ComentariMetge,'
      'T.ComentariInfermeria, T.C_EstatFac, C.N_CODI, C.R_Codi'
      ''
      
        'From ((((TRACTAMENTS T JOIN Prestacion P on T.C_Prestacio    = P' +
        '.C_Prestacio)'
      
        '                  LEFT JOIN METGES    M   ON T.C_COORDINADOR  = ' +
        'M.CODI)'
      
        '                  LEFT JOIN METGES    M2  ON T.C_METGEPREALTA = ' +
        'M2.CODI)'
      
        '                  LEFT JOIN CODICAMPS C   ON C.TIPUSCODI = "ESTA' +
        'TFACTU" AND T.C_ESTATFAC = C.C_CODI)'
      
        '                  LEFT JOIN FILIACIO  F   ON T.C_HISTORIA     = ' +
        'F.NUM_HIST'
      
        '                                         AND F.ESVIU          = ' +
        '"S"'
      '                                         AND F.BLOQUEIG IS NULL'
      'where CaducaPermis >='
      '"TODAY"'
      '[AND FILTRO]'
      '[ORDEN]'
      ' ')
    Dicionario1 = wDataBasics.Tractaments
    Orden.Strings = (
      'CADUCAPERMIS')
    OrdenDB.Strings = (
      'CADUCAPERMIS')
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = False
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    AlPintarGrid = cRenovacioMutuesAlPintarGrid
    Left = 273
    Top = 295
  end
