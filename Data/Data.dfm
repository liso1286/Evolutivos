  object QDretsGrup: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'SELECT  DG.C_DRET, D.DESCRIPCIO'
      'FROM GRUPS G, DRETSGRUPs DG, DRETS D'
      'WHERE G.C_GRUP = DG.C_GRUP'
      'AND DG.C_DRET = D.C_DRET'
      'AND G.C_GRUP = :grup'
      ' ')
    Left = 32
    Top = 130
    ParamData = <
      item
        DataType = ftString
        Name = 'grup'
        ParamType = ptUnknown
      end>
  end
  object QDretsAcces: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      'SELECT A.C_ACCES, DA.C_DRET,D.DESCRIPCIO, A.C_LOGIN'
      'FROM ACCESOS A'
      'left join DRETSACCES DA on a.c_acces=da.c_acces'
      'left join drets d on da.c_dret=d.c_dret'
      'WHERE ((upper(A.C_LOGIN) = upper(:LOGIN) ) AND '
      '(UPPER(A.C_PLACA) = UPPER(:PLACA))'
      'AND a.C_LOGIN IS NOT NULL AND a.C_PLACA IS NOT NULL )'
      'OR'
      '(UPPER(a.C_LOGIN)=UPPER(:LOGIN) AND a.C_PLACA IS NULL)'
      'OR'
      '(UPPER(a.C_PLACA)=UPPER(:PLACA) AND a.C_LOGIN IS NULL)'
      'ORDER BY C_PLACA DESC'
      ''
      '')
    Left = 99
    Top = 130
    ParamData = <
      item
        DataType = ftString
        Name = 'LOGIN'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'PLACA'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'LOGIN'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'PLACA'
        ParamType = ptUnknown
      end>
  end
  object QDretsMetge: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'SELECT DM.C_DRET, D.DESCRIPCIO, M.CODI, M.C_GRUP'
      'FROM METGES M, DRETSMETGES DM, DRETS D'
      'WHERE M.CODI = DM.C_USUARI'
      'AND   DM.C_DRET = D.C_DRET'
      'AND  CODI = :usuari')
    Left = 168
    Top = 130
    ParamData = <
      item
        DataType = ftString
        Name = 'usuari'
        ParamType = ptUnknown
      end>
  end
  object QDretsEspecial: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'SELECT  DE.C_DRET, D.DESCRIPCIO'
      'FROM ESPECIAL E, DRETSESPECIAL DE, DRETS D'
      'WHERE E.C_ESPECIAL = DE.C_ESPECIAL'
      'AND DE.C_DRET = D.C_DRET'
      'AND E.C_ESPECIAL = :especial')
    Left = 240
    Top = 130
    ParamData = <
      item
        DataType = ftString
        Name = 'especial'
        ParamType = ptUnknown
      end>
  end
  object qDretsPresta: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'SELECT  DP.C_DRET, D.DESCRIPCIO'
      'FROM PRESTACION P, DRETSPRESTA DP, DRETS D'
      'WHERE P.C_PRESTACIO = DP.C_PRESTACIO'
      'AND DP.C_DRET = D.C_DRET'
      'AND P.C_PRESTACIO = :PRESTACIO'
      ''
      ' '
      ' ')
    Left = 312
    Top = 130
    ParamData = <
      item
        DataType = ftString
        Name = 'PRESTACIO'
        ParamType = ptUnknown
      end>
  end
  object UpTraza: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'UPDATE TRAZACONTROL'
      'SET HORAS = "NOW",'
      'STATUS = :STATUS'
      'WHERE PK = :PK'
      ' '
      ' ')
    Left = 305
    Top = 72
    ParamData = <
      item
        DataType = ftString
        Name = 'STATUS'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'PK'
        ParamType = ptUnknown
      end>
  end
  object InsTraza: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'INSERT INTO TRAZACONTROL'
      
        '(PK, C_Acces, C_Usuari, ExtraId, HoraE, C_Historia, NomPC, Consu' +
        'lta, Aplicacio, Referencia, C_Grup, C_Especial)'
      'VALUES'
      
        '(:PK, :C_Acces, :C_Usuari, :ExtraId, "NOW",  :C_Historia, :NomPC' +
        ', :Consulta, :Aplicacio, :Referencia, :C_Grup, :C_Especial)'
      ' ')
    Left = 185
    Top = 72
    ParamData = <
      item
        DataType = ftInteger
        Name = 'PK'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'C_Acces'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'C_Usuari'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'ExtraId'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'C_Historia'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'NomPC'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'Consulta'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'Aplicacio'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'Referencia'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'C_Grup'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'C_Especial'
        ParamType = ptInput
      end>
  end
  object QMetges: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'SELECT'
      'm.codi AS C_USUARI,'
      'm.METGE,'
      'm.NOMSENCER,'
      'm.COGNOM,'
      'm.NC,'
      'm.C_PROV,'
      'm.NOM,'
      'm.TRACTE,'
      'm.DIGCON,'
      'm.C_GRUP,'
      'm.C_Especial,'
      'm.NMetgeRecepta,'
      'g.N_Grup,'
      'g.Color,'
      'e.N_Especial,'
      'e.c_area, a.c_area as c_area2, T.titol'
      'from METGES M'
      'join GRUPS G on M.C_GRUP = G.C_GRUP'
      'join ESPECIAL E on E.C_ESPECIAL = M.C_Especial'
      
        'left outer join AREAGRUPESP A on M.C_GRUP = A.C_GRUP and M.C_ESP' +
        'ECIAL = A.C_ESPECIALITAT'
      
        'left outer join TITULACIONS T on M.CODI = T.C_USUARI and T.C_UNI' +
        'TAT = 1'
      'where M.CODI = :CODI')
    Left = 24
    Top = 193
    ParamData = <
      item
        DataType = ftString
        Name = 'CODI'
        ParamType = ptUnknown
      end>
  end
  object qMetgesExtra: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'SELECT'
      'm.codi AS C_USUARI,'
      'm.METGE,'
      'm.COGNOM,'
      'm.NOM,'
      'm.DIGCON,'
      'm.GRUP AS C_GRUP,'
      'm.CESPE,'
      'g.N_GRUP as Grup,'
      'g.color,'
      'e.N_ESPECIAL as Especial'
      ''
      'FROM METGEEXTRA M, GRUPS G, ESPECIAL E'
      'WHERE Codi = :CODI'
      'AND C_EXTRA = :EXTRA'
      'AND M.GRUP = G.C_GRUP'
      'AND E.C_ESPECIAL = M.CESPE'
      ''
      ''
      ' '
      ' '
      ' '
      ' '
      ' ')
    Left = 96
    Top = 193
    ParamData = <
      item
        DataType = ftString
        Name = 'CODI'
        ParamType = ptUnknown
      end
      item
        DataType = ftString
        Name = 'EXTRA'
        ParamType = ptUnknown
      end>
  end
