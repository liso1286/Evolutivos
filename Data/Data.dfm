  object qTractamentsActius: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      
        'Select t.c_tractament, t.C_Prestacio, t.Data_Ingres, t.C_Coordin' +
        'ador, m.Metge'
      
        'from Tractaments t left outer join Metges M on t.C_Coordinador =' +
        ' M.Codi'
      'where t.C_Historia = '
      'x'
      'and (t.data_alta is null)')
    Left = 464
    Top = 192
  end
