  object qDadesFac: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'SELECT  T.C_CentreFac, T.C_Client, T.C_Delegacio, '
      
        '                T.CaducaPermis, T.PercentatgePacient, T.Referenc' +
        'ia, T.C_EstatFac, T.Data_Sinistre, T.Matricula_Vehicle/*, Papers' +
        '*/, T.id_garant, g.nom, g.cognom1, g.cognom2'
      
        'FROM TRACTAMENTS T LEFT JOIN GARANTS G ON T.ID_GARANT=G.ID_GARAN' +
        'T'
      'WHERE T.C_TRACTAMENT = '
      'x')
    Left = 224
    Top = 194
  end
  object qPrestaActives: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      
        'Select E.C_Espera, E.C_Prestacio, E.C_Estat, E.Data_PreIngres, E' +
        '.C_Coordinador, M.Metge'
      
        'from Espera E left outer join Metges M on E.C_Coordinador = M.Co' +
        'di'
      'where E.C_Historia = '
      'x'
      '    and E.C_TractamentDesti is null '
      '    and E.C_Estat Between 10 and 39'
      '    and E.Exclos = '
      #39'N'#39
      ''
      ''
      '')
    Left = 304
    Top = 192
  end
  object qInfCabe: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'SELECT *'
      'FROM INFCABETEXTE'
      'WHERE C_INFORME = :C_INFORME'
      'AND   C_IDIOMA = :C_IDIOMA'
      ' ')
    Left = 401
    Top = 72
    ParamData = <
      item
        DataType = ftString
        Name = 'C_INFORME'
        ParamType = ptUnknown
      end
      item
        DataType = ftInteger
        Name = 'C_IDIOMA'
        ParamType = ptUnknown
      end>
  end
  object DadesHistoria: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'SELECT NomComplet, DNI, ADRESA, CODIGO, POBLACIO, PROVINCIA, IDI' +
        'OMA'
      'FROM FILIACIO '
      'WHERE NUM_HIST = :C_Historia')
    Left = 245
    Top = 72
    ParamData = <
      item
        DataType = ftInteger
        Name = 'C_Historia'
        ParamType = ptUnknown
      end>
  end
  object qProcesActiu: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      
        'select T.C_TRACTAMENT, T.C_PRESTACIO, T.DATA_INGRES, T.DATA_ALTA' +
        ', T.C_COORDINADOR, M.METGE, T.C_PROCES, T.FI_PROCES, T.METGE_PRO' +
        'CES'
      'from TRACTAMENTS T '
      'join METGES M on T.C_COORDINADOR = M.CODI'
      
        'join CODICAMPS F on T.C_ESTATFAC = F.C_CODI and F.TIPUSCODI = "E' +
        'STATFACTU" and F.R_CODI <> 9'
      'where T.C_HISTORIA = '
      'x       /*  num_hist   l'#237'nia  5 */'
      'and T.C_PROCES is not null'
      'and (T.C_PRESTACIO = '#39'1004'#39' or C_PRESTACIO = '#39'2014'#39')'
      'order by T.DATA_INGRES')
    Left = 378
    Top = 192
  end
  object qDretsMotiu: TQuery
    DatabaseName = 'Interna'
    SessionName = 'Default'
    SQL.Strings = (
      'select DM.C_DRET, D.DESCRIPCIO'
      'from CODICAMPS M'
      'join DRETSMOTIU DM on  M.C_CODI = DM.C_MOTIU'
      'join DRETS D on DM.C_DRET = D.C_DRET'
      'where M.C_CODI = :c_motiu'
      'and M.TIPUSCODI = '#39'MOTIU'#39
      ''
      ' '
      ' ')
    Left = 376
    Top = 130
    ParamData = <
      item
        DataType = ftSmallint
        Name = 'c_motiu'
        ParamType = ptInput
      end>
  end
