  object qBuscaDretPresta: TIBQuery
    Database = IBGuttmann
    Transaction = IBTransGutt
    BufferChunks = 1000
    CachedUpdates = False
    SQL.Strings = (
      'select DP.C_PRESTACIO, DP.C_DRET, D.DESCRIPCIO'
      'from DRETSPRESTA DP'
      'join   DRETS D on DP.C_DRET = D.C_DRET'
      'where  DP.C_PRESTACIO = :c_prestacio'
      'and      DP.C_DRET = :c_dret')
    Left = 608
    Top = 128
    ParamData = <
      item
        DataType = ftString
        Name = 'c_prestacio'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'c_dret'
        ParamType = ptInput
      end>
  end
  object qBloqueigAcc: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      'select B.NOMPC, B.C_USUARI, C.N_CODI as AVIS'
      'from BLOQUEIG_ACC B'
      'join CODICAMPSALFA C on C.TIPUSCODI = '#39'BLOQUEIG_ACC'#39' '
      '                                       and B.QUE = C.C_CODI'
      'where B.QUE = :que '
      'and     B.C_HISTORIA = :c_historia '
      'and     B.NOMID = :nomid'
      'and     B.ID = :id')
    Left = 24
    Top = 248
    ParamData = <
      item
        DataType = ftString
        Name = 'que'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'c_historia'
        ParamType = ptInput
      end
      item
        DataType = ftString
        Name = 'nomid'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'id'
        ParamType = ptInput
      end>
  end
