          object QRMemo1: TQRMemo
            Left = 16
            Top = 227
            Width = 645
            Height = 430
            Frame.Color = clBlack
            Frame.DrawTop = False
            Frame.DrawBottom = False
            Frame.DrawLeft = False
            Frame.DrawRight = False
            Size.Values = (
              1137.70833333333
              42.3333333333333
              600.604166666667
              1706.5625)
            Alignment = taLeftJustify
            AlignToBand = False
            AutoSize = False
            AutoStretch = False
            Color = clWhite
            Lines.Strings = (
              
                'Podreu canviar la clau de pas tantes vegades com vulgueu. Per fe' +
                'r-ho, podeu clicar el link corresponent en el formulari d'#39'entrad' +
                'a de la contrasenya, o b'#233' pitjar la tecla F2 en la primera panta' +
                'lla del Curs Cl'#237'nic.'
              ''
              
                'Haureu d'#39'escriure la clau de pas antiga i a continuaci'#243' la nova ' +
                '(en demana confirmaci'#243').'
              ''
              ''
              ''
              'Caracter'#237'stiques que ha de complir de la clau de pas:'
              ''
              '        '#8226' Longitud m'#237'nima: 8 d'#237'gits.'
              ''
              
                '        '#8226' Ha de complir com a m'#237'nim 3 de les 4 condicions seg'#252'en' +
                'ts:'
              ''
              '                    1. Contenir una maj'#250'scula'
              '                    2. Contenir una min'#250'scula'
              '                    3. Contenir un n'#250'mero'
              '                    4. Contenir un s'#237'mbol'
              ''
              ''
              
                'La clau de pas caducar'#224' cada 3 mesos i caldr'#224' que la canvieu (el' +
                ' sistema ho demanar'#224' autom'#224'ticament).'
              ''
              
                'A m'#233's es guardar'#224' un hist'#242'ric de 3 claus que no es podran repeti' +
                'r.'
              ''
              
                'El sistema inhabilitar'#224' l'#39'usuari durant 30 minuts despr'#233's de 3 e' +
                'ntrades incorrectes i el bloquejar'#224' despr'#233's de 6 entrades incorr' +
                'ectes. ')
            Transparent = False
            WordWrap = True
            FontSize = 10
          end
