  object pPrestaMetge: THYConsulta
    Abierta = False
    SqlDic.Strings = (
      'SELECT * '
      'FROM [DIC1]'
      'WHERE NOT C_PRESTACIO IN '
      '        ( SELECT C_PRESTACIO '
      '          FROM [DIC2] '
      '          WHERE CODI = "A04" )'
      '[AND FILTRO]'
      '[ORDEN]'
      '')
    SqlDicTotal.Strings = (
      'SELECT COUNT(*) '
      'FROM [DIC1]'
      'WHERE NOT C_PRESTACIO IN '
      '        ( SELECT C_PRESTACIO '
      '          FROM [DIC2] '
      '          WHERE CODI = "A04" )'
      '[AND FILTRO]'
      '[ORDEN]'
      '')
    Dicionario1 = wDataBasics.Prestacion
    Dicionario2 = wDataCodis.MetgePresta
    Filtros = <>
    OrdenAuto = True
    AgrupaPagina = False
    MultiSelect = True
    RowSelect = False
    PrintAncho = 0
    SoloUnaLinea = False
    VerSeleccionar = True
    AlSeleccionar = pPrestaMetgeAlSeleccionar
    Left = 848
    Top = 123
  end
