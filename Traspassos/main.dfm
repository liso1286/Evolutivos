  object qVIPB: TQuery
    DatabaseName = 'internavip'
    SQL.Strings = (
      'select  c_historia, c_tractament, usuarias, dataas,'
      'TREB_CANVIS_NIVELL_ESTUDIS, TREB_CANVIS_CONVI_ULT_REV,'
      'TREB_CANVIS_HABIT_ULT_REV, TREB_GRAU_SATIFACCIO_HABITATGE,'
      'TREB_NO_PERQUE,  TREB_TREBALLA_TIPUS_TREBALL, '
      'TREB_ESTA_ASEGURAT, TREB_CANVIS_TREBALL_ULT_REV,'
      'TREB_GRAU_SATIFACCIO_LABORAL, TREB_CANVIS_PENSIO_ULT_REV,  '
      'TREB_GRAU_SATIFACCIO_PENSIO, TREB_CANVIS_MOB_ENTORN_ULT_REV,'
      'TREB_GRAU_SATIF_MOB_ENTORN, TREB_3_5DIES_SETMANA, '
      'TREB_2DIES_SETMANA,  TREB_1DIA_SETMANA,'
      'TREB_1DIA_MES,  TREB_ESPORADICAMENT,  TREB_ALTRA_FREQUENCIA,'
      'TREB_MES_3HORES_DIA, TREB_1A3HORES_DIA,  '
      'TREB_MENYS_1HORA_DIA, TREB_CANVIS_ALTRES_ACT_ULT_REV, '
      'TREB_GRAU_SATIF_ALTRES_ACT, TREB_GRAU_SATIF_AVD, '
      'TREB_CANVIS_SUP_AVD_ULT_REV'
      'from vip'
      'where TREB_CANVIS_NIVELL_ESTUDIS is not null'
      'or TREB_CANVIS_CONVI_ULT_REV is not null'
      'or TREB_CANVIS_HABIT_ULT_REV is not null'
      'or TREB_GRAU_SATIFACCIO_HABITATGE is not null'
      'or TREB_NO_PERQUE is not null'
      'or TREB_TREBALLA_TIPUS_TREBALL is not null'
      'or TREB_ESTA_ASEGURAT is not null'
      'or TREB_CANVIS_TREBALL_ULT_REV is not null'
      'or TREB_GRAU_SATIFACCIO_LABORAL is not null'
      'or TREB_CANVIS_PENSIO_ULT_REV is not null'
      'or TREB_GRAU_SATIFACCIO_PENSIO is not null'
      'or TREB_CANVIS_MOB_ENTORN_ULT_REV is not null'
      'or TREB_GRAU_SATIF_MOB_ENTORN is not null'
      'or TREB_3_5DIES_SETMANA is not null'
      'or TREB_2DIES_SETMANA is not null'
      'or TREB_1DIA_SETMANA is not null'
      'or TREB_1DIA_MES is not null'
      'or TREB_ESPORADICAMENT is not null'
      'or TREB_ALTRA_FREQUENCIA is not null'
      'or TREB_MES_3HORES_DIA is not null '
      'or TREB_1A3HORES_DIA is not null'
      'or TREB_MENYS_1HORA_DIA is not null'
      'or TREB_CANVIS_ALTRES_ACT_ULT_REV is not null'
      'or TREB_GRAU_SATIF_ALTRES_ACT is not null'
      'or TREB_GRAU_SATIF_AVD is not null'
      'or TREB_CANVIS_SUP_AVD_ULT_REV is not null'
      'order by id desc')
    Left = 168
    Top = 306
