  object qVIP2: TQuery
    DatabaseName = 'internavip'
    SQL.Strings = (
      'select c_tractament, c_historia, USUARIAS, DATAAS,'
      'TREB_NUM_PERS_CONV,TREB_CONVIU_AMB, TREB_QUANTS_FAMILIA,'
      'TREB_QUANTES_FAMILIA,TREB_HORAS_ASSIST_PAGADES_DIA,'
      'TREB_HORAS_ASSIST_NO_PAG_DIA,TREB_HORAS_DIA_AIXECAT,'
      'TREB_DC_PERSONA_A_CASA_SEVA,TREB_DC_PERSONA_AMB_VOSTE,'
      'TREB_HORAS_SETMANA_ESTUDIANT,PSI_AUTOSUFICIENT_ECONOMICAMENT,'
      'PSI_TE_SUPORT_ECONOMIC,PSI_DESP_SANIT_NO_PAGA_SEG_SOC,'
      'PSI_QUANTIT_DESP_SANIT_NO_SEGSO,TREB_HORES_SETMANA_REMUNERADES,'
      'TREB_CONTACTES_MES_DE_NEGOCIS,TREB_DIES_SETMANA_FORA_CASA,'
      'TREB_NITS_FORA_CASA_ANY_PASSAT,TREB_HORAS_SETMANA_TASQ_DOMESTI,'
      'TREB_HORAS_SETMANA_MANT_HOGAR,TREB_HORAS_SETMANA_OCI,'
      'TREB_CONTACTES_AMB_AMICS,TREB_CONVERSACIONS_DESCONEG_MES,'
      'TREB_FREQ_PROBLEM_DISP_TRANSP,TREB_PROBLEM_TRANSP,'
      'TREB_FREQ_PROBLEM_MEDI_NATURAL,TREB_PROBLEM_MEDI_NAT,'
      'TREB_FREQ_PROBLEM_ENTORN,TREB_PROBLEM_ENTORN,'
      'TREB_FREQ_PROBLEM_DISP_TRANSP ,TREB_PROBLEM_INFORMACIO,'
      'TREB_MAL_ACTIT_PERSON_A_CASA,TREB_PROBLEM_ACTI_PERS_CASA,'
      'TREB_NECESITAT_AJUD_A_CASA,TREB_PROBLEM_NO_AJUD_A_CASA,'
      'TREB_NECESITAT_AJUD_A_FEINA, TREB_PROBLEM_NO_AJUD_A_FEINA,'
      'TREB_MAL_ACTIT_PERSON_TREBALL, TREB_PROBLEM_ACTI_PERS_TREBALL,'
      'TREB_DISP_SERV_SALUD, TREB_PROBLEM_SERV_SALUD,'
      'TREB_SENTIT_PREJUICIS , TREB_PROBLEM_SENTIT_PREJUICIS,'
      'TREB_POLIT_NORMES_INTITUCIONS , TREB_PROBLEM_POLIT_NORMES,'
      'TREB_GOBERN_ADMINIST_DIFICULT, TREB_PROBLEM_GOBERN_ADMINIST'
      'FROM VIP'
      'where USUARIAS IS NOT NULL'
      '/* filtre per id m'#237'nima fila26*/'
      '/* filtre per id m'#224'xima fila27*/'
      'ORDER BY ID')
    Left = 50
    Top = 402
