  object qIngressos: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'select t.c_historia, t.data_alta, f.tsi, t.c_diagnosticalta, c.n' +
        '_icd, f.apellido1, f.apellido2, f.sexo, f.fecha_nac, t.informeal' +
        'ta, t.c_coordinador'
      'from tractaments t'
      'left join filiacio f on t.c_historia = f.num_hist'
      'left join codiicd c on t.c_diagnosticalta = c.c_icd'
      
        'where t.c_prestacio = '#39'1004'#39' and t.c_centrefac = '#39'04'#39' and t.c_cl' +
        'ient = '#39'UP'#39
      'and t.data_alta >= '#39'01.01.2005'#39' and f.esviu ='#39'S'#39
      'order by t.c_historia, t.data_alta')
    Left = 536
    Top = 534
  end
