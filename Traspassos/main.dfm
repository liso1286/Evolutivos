  object InsESIG_1AV: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'INSERT INTO ESCESIG_1AV(id, c_tractament, c_historia, c_usuari, ' +
        'data, '
      
        'c_entrada, anulat, data_anulat, c_validador, data_validat, estud' +
        'is, convivencia_i,'
      
        'convivencia_a, residencia_i, residencia_a, llar_a, ACCESSIBILITA' +
        'T, laboral_i,'
      
        'laboralqui_i, laboralon_i, laboral_a, laboralqui_a, laboralon_a,' +
        ' pensio, MOBILITAT1,'
      
        'MOBILITAT2, MOBILITAT3, MOBILITAT4, MOBILITAT5, MOBILITAT6, MOBI' +
        'LITAT7, '
      
        'MOBILITAT8, figura, dedicacio, SERVEI1, SERVEI2, SERVEI3, SERVEI' +
        '4, SERVEI5, '
      'SERVEI6, SERVEI7, SERVEI8, SERVEI9, SERVEI10, SERVEI11)'
      'values(:id, :c_tractament, :c_historia, :c_usuari, :data, '
      
        ':c_entrada, :anulat, :data_anulat, :c_validador, :data_validat, ' +
        ':estudis, '
      
        ':convivencia_i, :convivencia_a, :residencia_i, :residencia_a, :l' +
        'lar_a, '
      
        ':ACCESSIBILITAT, :laboral_i, :laboralqui_i, :laboralon_i, :labor' +
        'al_a, '
      ':laboralqui_a, :laboralon_a, :pensio, :MOBILITAT1, :MOBILITAT2, '
      
        ':MOBILITAT3, :MOBILITAT4, :MOBILITAT5, :MOBILITAT6, :MOBILITAT7,' +
        ' '
      
        ':MOBILITAT8, :figura, :dedicacio, :SERVEI1, :SERVEI2, :SERVEI3, ' +
        ':SERVEI4, :SERVEI5, '
      ':SERVEI6, :SERVEI7, :SERVEI8, :SERVEI9, :SERVEI10, :SERVEI11)')
