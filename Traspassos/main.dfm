  object qLogHCCC: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'select t.c_historia, f.tsi, t.c_tractament, t.c_prestacio, t.dat' +
        'A_ingres, t.data_alta, '
      
        '          t.hccc_informe_alta, t.informealta, t.c_metgealta, t.c' +
        '_coordinador,l.*'
      'from tractaments t'
      'join filiacio f on t.c_historia=f.num_hist'
      'left join loghccc l on t.c_tractament=l.c_tractament'
      'where t.hccc_informe_alta is not null '
      'and l.pk is null')
