  object qAltes: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      'select c_historia, data_alta, informealta, c_coordinador'
      'from tractaments'
      
        'where c_prestacio = '#39'1004'#39' and c_centrefac = '#39'04'#39' and c_client =' +
        ' '#39'UP'#39
      '/*and data_alta between '#39'1.10.2012'#39' and '#39'5.11.2012'#39'*/'
      
        'and data_alta >= "TODAY" - 15 /* publiquem els donats d'#39'alta ahi' +
        'r */'
      ''
      '/*and (informealta is not null) and (estatinformealta >=5) */'
      'and (hccc_informe_alta is null)'
      ''
      'AND C_HISTORIA IN (701) '
      'order by data_alta')
    Left = 616
    Top = 534
  end
  object qTractGTN: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'select C_TRACTAMENT, C_HISTORIA, C_PRESTACIO, DATA_INGRES, HORA,' +
        ' DATA_ALTA, '
      
        '           C_DIAGNOSTICALTA, C_CODI_E,C_CODI_E2, C_CODI_E3, C_CO' +
