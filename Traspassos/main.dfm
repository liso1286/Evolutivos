  object qAnotaPsico: TQuery
    DatabaseName = 'Interna'
    SQL.Strings = (
      
        'select a.*, h.c_prestacio, h.data, h.c_usuari, h.c_historia, f.f' +
        'echa_nac, f_divisa((h.data - f.fecha_nac)/365,0) as edat from an' +
        'otapsicologia a'
      'join historia h on a.c_anotacio=h.c_anotacio'
      
        'join tractaments t on h.c_tractament=t.c_tractament and t.c_pres' +
        'tacio in('#39'1004'#39','#39'2014'#39','#39'2008'#39')'
      'join filiacio f on h.c_historia=f.num_hist'
      'where h.anulat='#39'N'#39
      '/* LINIA 5 */')
    Left = 56
    Top = 624
  end
